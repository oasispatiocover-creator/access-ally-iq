{
  "expo": {
    "name": "Access Ally IQ",
    "slug": "access-ally-iq",
    "scheme": "accessallyiq",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.accessallyiq.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Access Ally IQ uses your photo library so you can add a picture of your service dog to its profile.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.accessallyiq.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0A1426"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Access Ally IQ uses your photo library so you can add a picture of your service dog to its profile.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}
